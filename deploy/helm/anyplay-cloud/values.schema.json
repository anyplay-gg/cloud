{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicas": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "config": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "relays": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } },
        "mail": { "enum": ["smtp", "log"] },
        "mailFrom": { "type": "string" },
        "smtpHost": { "type": "string" },
        "smtpPort": { "type": ["string", "integer"] },
        "smtpTls": { "enum": ["starttls", "tls", "none"] },
        "signup": { "enum": ["open", "closed"] },
        "privacyUrl": { "type": "string" },
        "termsUrl": { "type": "string" },
        "publicUrl": { "type": "string" },
        "termsVersion": { "type": "string" },
        "minLauncherVersion": { "type": "string" },
        "trustProxy": { "type": "boolean" },
        "databaseConnections": { "type": "integer", "minimum": 1 },
        "postgresMaxConnections": { "type": "integer", "minimum": 1 },
        "databaseAcquireTimeoutMs": { "type": "integer", "minimum": 100 },
        "databaseStatementTimeoutMs": { "type": "integer", "minimum": 0 },
        "requestTimeoutSecs": { "type": "integer", "minimum": 0 },
        "drainSeconds": { "type": "integer", "minimum": 0 },
        "logFormat": { "enum": ["json", "text"] },
        "extra": { "type": "object" }
      }
    },
    "natsUrl": { "type": "string", "pattern": "^(|nats://.+|tls://.+)$" },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "keys": {
          "type": "object",
          "properties": {
            "databaseUrl": { "type": "string", "minLength": 1 },
            "smtpUsername": { "type": "string", "minLength": 1 },
            "smtpPassword": { "type": "string", "minLength": 1 },
            "adminToken": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "signingKey": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "key": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" }
      }
    },
    "extraEnv": { "type": "array" },
    "ports": {
      "type": "object",
      "properties": {
        "http": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metrics": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "strategy": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": ["integer", "null"], "minimum": 1 },
    "probes": { "type": "object" },
    "resources": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "topologySpreadConstraints": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "podDisruptionBudget": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "path": { "type": "string" },
              "pathType": { "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
            },
            "required": ["host"]
          }
        },
        "tls": { "type": "array" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "apiFrom": { "type": "array" },
        "metricsFrom": { "type": "array" },
        "postgres": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "to": { "type": "array", "minItems": 1 }
          }
        },
        "nats": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "to": { "type": "array", "minItems": 1 }
          }
        },
        "smtp": { "type": "object", "properties": { "to": { "type": "array", "minItems": 1 } } },
        "dns": { "type": "object", "properties": { "to": { "type": "array", "minItems": 1 } } }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "labels": { "type": "object" }
      }
    }
  }
}
