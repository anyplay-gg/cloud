# Copy this file to `.env` and fill in the values that have no default.

# Two host names that point at this machine (DNS A and AAAA records), for example
# cloud.example.com and relay.example.com. Caddy fetches a certificate for each.
CLOUD_DOMAIN=
RELAY_DOMAIN=

# An address Let's Encrypt can reach you at about certificates.
ACME_EMAIL=

# The name players see.
CLOUD_NAME=AnyPlay cloud

# Sign-in codes go out by SMTP. For a first try on your own machine you can set MAIL=log;
# then the codes appear in `docker compose logs cloud` instead.
MAIL=smtp
MAIL_FROM=AnyPlay cloud <noreply@example.com>
SMTP_HOST=
SMTP_PORT=
# Leave empty to follow the port: tls (implicit TLS) on 465, starttls otherwise.
# Or set starttls (port 587), tls (port 465) or none.
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=

# open or closed
SIGNUP=open
PRIVACY_URL=
TERMS_URL=
# The version of the terms in force, such as 2026-10. Players who accepted another one are asked
# again at their next sign-in on the web. Leave empty when there are no terms.
TERMS_VERSION=

# At least 16 characters; switches on `docker compose exec cloud anyplay-cloud admin ...`.
# Leave empty to keep the admin routes off.
ADMIN_TOKEN=

# Optional: the website (anyplaynet/web) on the cloud's host name, see docs/deploy.md.
# COMPOSE_FILE=compose.yaml:compose.web.yaml
# WEB_DIR=../../web

# Backups (docs/deploy.md, "Backups"). update.sh runs backup.sh before every update. All optional.
# Where the archives go; keep this on another disk or machine's mount if you can.
# ANYPLAY_BACKUP_DIR=./backups
# How many archives backup.sh keeps.
# ANYPLAY_BACKUP_KEEP=14
# update.sh refuses to go on when the newest archive is older than this many seconds.
# ANYPLAY_BACKUP_MAX_AGE=900
# The Docker volume that holds the database and the keys (project name "anyplay" + "_cloud-data").
# ANYPLAY_CLOUD_VOLUME=anyplay_cloud-data
