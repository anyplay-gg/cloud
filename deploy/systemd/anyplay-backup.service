# A scheduled backup of the cloud data (example; adjust the paths and the user).
#
#   sudo cp anyplay-backup.service anyplay-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now anyplay-backup.timer
#
# --online snapshots the database with SQLite's online backup API while the cloud keeps running (no downtime); without it
# backup.sh stops the cloud for tens of seconds. flock makes the run skip while update.sh holds the same lock (update.sh
# takes its own backup before it starts the new version). To also copy the archive off the server, set
# ANYPLAY_OFFSITE_TARGET in deploy/.env (see offsite.sh) and uncomment the ExecStartPost line.
[Unit]
Description=AnyPlay cloud backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# A user in the docker group; the archives belong to it and are mode 0600.
User=anyplay
WorkingDirectory=/opt/anyplay/cloud/deploy
ExecStart=/usr/bin/flock -n /tmp/anyplay-update.lock /opt/anyplay/cloud/deploy/backup.sh --online
#ExecStartPost=/opt/anyplay/cloud/deploy/offsite.sh
# Settings can also go in deploy/.env: ANYPLAY_BACKUP_DIR, ANYPLAY_BACKUP_KEEP.
TimeoutStartSec=15min
