{
	"name": "anyplay-portal",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-only",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"dev:cloud": "VITE_API=http vite",
		"build": "vite build",
		"build:mock": "vite build --mode mock --outDir dist-mock",
		"preview": "vite preview",
		"tokens": "node scripts/gen-tokens.mjs",
		"typecheck": "pnpm i18n && tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"a11y": "node scripts/a11y.mjs",
		"shots": "node scripts/shots.mjs",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy localStorage preferredLanguage baseLocale"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@hookform/resolvers": "5.9.1",
		"@tanstack/react-query": "5.104.3",
		"@tanstack/react-router": "1.170.45",
		"clsx": "2.1.1",
		"lucide-react": "1.58.0",
		"motion": "14.3.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-hook-form": "7.90.0",
		"tailwind-merge": "3.7.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@inlang/paraglide-js": "2.29.0",
		"@inlang/plugin-message-format": "4.5.4",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-plugin": "1.168.47",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"axe-core": "4.14.0",
		"culori": "4.0.2",
		"jsdom": "30.1.3",
		"playwright-core": "1.64.1",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
